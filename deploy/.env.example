# Chép thành .env cạnh compose.yaml trên VPS rồi điền giá trị thật. Bí mật chỉ nằm ở file này.
# chmod 600 .env

# --- Image ---
# Chủ sở hữu trên GHCR (viết thường), ví dụ tên user hoặc org GitHub
GHCR_OWNER=owner
# Ghim theo phiên bản, không dùng latest trên production. Rollback: đặt lại tag cũ.
IMAGE_TAG=v0.1.0

# --- App ---
APP_HOST=app3.domain.xyz
APP_URL=https://app3.domain.xyz
# Trỏ tới tên service Postgres trên POSTGRES_NETWORK, role và database riêng của app
DATABASE_URL=postgres://my_credit:CHANGE_ME@postgres:5432/my_credit
DATABASE_POOL_MAX=5
LOG_LEVEL=info

# --- Network ngoài có sẵn trên VPS ---
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
POSTGRES_NETWORK=postgres

# --- Sao lưu (scripts/backup.sh) ---
# Public key của age (age1...). Private key giữ ngoài VPS.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
BACKUP_DIR=/var/backups/my-credit
BACKUP_KEEP=14
# Major phải bằng hoặc mới hơn phiên bản server Postgres
PG_IMAGE=postgres:16-alpine
