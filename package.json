{
  "name": "my-credit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:scripts": "esbuild src/server/db/migrate.ts scripts/reset-password.ts --bundle --platform=node --target=node22 --format=esm --tsconfig=tsconfig.json --external:@node-rs/argon2 --external:pino --entry-names=[name] --outdir=dist/scripts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/server/db/migrate.ts",
    "reset-password": "tsx --env-file=.env scripts/reset-password.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  }
}
