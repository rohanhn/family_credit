# Chép thành .env rồi điền giá trị thật. Không commit .env.

# Kết nối PostgreSQL (database và role riêng của app, xem scripts/dev-db-init.sql)
DATABASE_URL=postgres://my_credit:CHANGE_ME@localhost:5432/my_credit
# Database riêng cho test chống race trên Postgres thật
DATABASE_URL_TEST=postgres://my_credit:CHANGE_ME@localhost:5432/my_credit_test
# Số kết nối tối đa trong pool (server Postgres dùng chung)
DATABASE_POOL_MAX=5

# Địa chỉ công khai của app (dùng cho kiểm tra Origin của Server Actions)
APP_URL=http://localhost:3000
